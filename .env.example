# Optional. Leave empty to keep the monitor answering from local placeholder copy.
# This value is compiled into the public bundle, so it must be a URL only — never a key.
VITE_AI_ENDPOINT=

# Server-side only (used by server/ai-proxy.example.js, never by the app bundle).
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_SYSTEM_PROMPT=
ALLOWED_ORIGIN=
CLIENT_TOKEN=
